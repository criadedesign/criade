---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'split';
}

const { eyebrow, title, subtitle, align = 'split' } = Astro.props;
---

<div
  class:list={[
    'pb-10 md:pb-14 border-b border-[var(--color-border)]',
    align === 'split'
      ? 'grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-end'
      : 'flex flex-col gap-4 max-w-3xl',
  ]}
  data-reveal
>
  <div class:list={[align === 'split' ? 'lg:col-span-7' : '']}>
    <div class="inline-flex items-center gap-2.5 mb-4">
      <span
        class="w-2 h-2 rounded-full bg-[var(--color-accent)]"
        aria-hidden="true"></span>
      <span class="meta-index text-[var(--color-muted)]">{eyebrow}</span>
    </div>
    <h2
      class="heading-section text-3xl sm:text-4xl md:text-5xl text-[var(--color-foreground)] uppercase text-balance"
    >
      {title}
    </h2>
  </div>

  {
    subtitle && (
      <div class:list={[align === 'split' ? 'lg:col-span-5 lg:pl-4' : '']}>
        <p class="text-base md:text-lg text-[var(--color-muted)] leading-relaxed text-pretty">
          {subtitle}
        </p>
      </div>
    )
  }
</div>

