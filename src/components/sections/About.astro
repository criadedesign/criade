---
import { Image } from 'astro:assets';
import { aboutContent } from '../../data/site-content';
import Icon from '../ui/Icon.astro';
import aboutStudioMugImg from '../../assets/about/about-studio-mug.webp';
---

<section
  id="sobre"
  aria-labelledby="sobre-heading"
  data-about-section
  class="about-section about-pending relative overflow-hidden py-20 md:py-28 lg:py-32 bg-[#F9F8F6] scroll-mt-20"
>
  <svg
    class="pointer-events-none absolute inset-0 w-full h-full z-0"
    viewBox="0 0 1440 680"
    fill="none"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <path
      data-about-drawable
      d="M-60 560 C 220 420, 480 610, 790 470 C 1080 340, 1270 190, 1520 240"
      stroke="#F47721"
      stroke-opacity="0.22"
      stroke-width="1.35"
      stroke-linecap="round"
    />
    <path
      data-about-drawable
      d="M1120 -40 C 1060 150, 1180 310, 1490 390"
      stroke="#171717"
      stroke-opacity="0.08"
      stroke-width="1.1"
      stroke-dasharray="5 7"
      stroke-linecap="round"
    />
  </svg>

  <div class="container-editorial relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-14 items-center">
      <div class="lg:col-span-5">
        <div
          data-about-photo-frame
          class="about-photo-frame group relative rounded-[22px] bg-[#111111] p-2 sm:p-2.5 shadow-[0_26px_60px_-24px_rgba(17,17,17,0.32)] border border-[#171717]/10"
        >
          <div class="relative overflow-hidden rounded-[16px] aspect-[16/10] sm:aspect-[16/9] bg-[#0D0D0D]">
            <Image
              src={aboutStudioMugImg}
              alt={aboutContent.imageAlt}
              width={1024}
              height={576}
              loading="lazy"
              decoding="async"
              data-about-photo-img
              class="w-full h-full object-cover object-center block will-change-transform transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />

            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-black/35 via-transparent to-[#F47721]/10"
              aria-hidden="true"
            ></div>

            <svg
              class="pointer-events-none absolute inset-0 w-full h-full"
              viewBox="0 0 640 360"
              fill="none"
              aria-hidden="true"
            >
              <path
                data-about-drawable
                d="M 18 316 C 148 242, 290 258, 412 338"
                stroke="#F47721"
                stroke-width="1.4"
                stroke-opacity="0.55"
                stroke-linecap="round"
              />
              <circle
                cx="398"
                cy="192"
                r="82"
                stroke="#F47721"
                stroke-width="1"
                stroke-opacity="0.28"
                stroke-dasharray="3 5"
              />
            </svg>

            <div
              class="pointer-events-none absolute top-3.5 right-3.5 flex items-center gap-2 rounded-full bg-black/55 backdrop-blur-md border border-white/12 px-3 py-1 text-[10px] font-medium tracking-[0.16em] uppercase text-white/85"
            >
              <svg
                data-about-reticle
                class="w-3 h-3 text-[#F47721]"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M8 1V15M1 8H15"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>
              <span>ESTÚDIO CRIADE</span>
            </div>
          </div>

          <div class="flex items-center justify-between px-2.5 pt-2.5 pb-1 text-[10px] tracking-[0.16em] uppercase text-white/65 font-medium">
            <span class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#F47721]"></span>
              <span>CRIATIVIDADE • ESTRATÉGIA • TECNOLOGIA</span>
            </span>
            <span class="text-[#F47721] font-semibold">MANIFESTO // 01</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-10 items-start">
          <div class="md:col-span-5">
            <div class="inline-flex items-center gap-3 mb-4">
              <span
                data-about-eyebrow-line
                class="w-8 h-[2px] bg-[#F47721] origin-left block"
                aria-hidden="true"
              ></span>
              <span
                data-about-eyebrow-text
                class="text-[11px] font-bold tracking-[0.16em] uppercase text-[#F47721]"
              >
                {aboutContent.eyebrow}
              </span>
            </div>

            <h2
              id="sobre-heading"
              class="heading-section text-[1.75rem] sm:text-[2rem] xl:text-[2.15rem] leading-[1.06] tracking-[-0.03em] uppercase text-[#171717]"
            >
              <span data-about-heading-line class="block">
                {aboutContent.headline.line1}
              </span>
              <span data-about-heading-line class="block mt-1">
                {aboutContent.headline.line2}
              </span>
              <span data-about-heading-line class="block mt-1">
                <span class="text-[#F47721]">{aboutContent.headline.line3Accent}</span>{' '}
                {aboutContent.headline.line3Suffix}
              </span>
            </h2>

            <div
              data-about-copy
              class="mt-6 pt-5 border-t border-[#E5E0D8] hidden md:flex items-center gap-3 text-[11px] text-[#5C5852] tracking-[0.06em]"
            >
              <span class="inline-block w-2 h-2 rounded-full bg-[#F47721]"></span>
              <span>Visão integrada para marcas que buscam relevância real.</span>
            </div>
          </div>

          <div class="md:col-span-7 relative md:pl-8 lg:pl-9">
            <span
              data-about-divider
              class="hidden md:block absolute left-0 top-1 bottom-1 w-[1.5px] bg-gradient-to-b from-[#F47721] via-[#DCD8D0] to-transparent origin-top"
              aria-hidden="true"
            ></span>

            <div class="space-y-4">
              <p
                data-about-copy
                class="text-[15px] sm:text-[16px] font-semibold text-[#171717] leading-[1.52] tracking-[-0.01em]"
              >
                {aboutContent.leadParagraph}
              </p>

              <p
                data-about-copy
                class="text-[13.5px] sm:text-[14.5px] text-[#3F3D39] leading-[1.68]"
              >
                {aboutContent.bodyParagraph}
              </p>

              <div
                data-about-closing
                class="pt-2 pb-1 pl-3.5 border-l-2 border-[#F47721]"
              >
                <p class="text-[14px] sm:text-[15px] font-bold text-[#171717] tracking-[-0.01em]">
                  {aboutContent.closingStatement}
                </p>
              </div>
            </div>

            <div class="mt-7">
              <a
                href={aboutContent.ctaHref}
                data-about-cta
                class="group/cta relative inline-flex items-center gap-3.5 rounded-full bg-[#171717] hover:bg-[#F47721] text-white px-7 py-3.5 text-xs sm:text-[13.5px] font-semibold tracking-[0.02em] shadow-[0_12px_28px_-10px_rgba(23,23,23,0.38)] hover:shadow-[0_16px_34px_-8px_rgba(244,119,33,0.48)] transition-colors duration-300"
              >
                <span>{aboutContent.ctaLabel}</span>
                <span
                  class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-white/12 group-hover/cta:bg-white/22 transition-transform duration-300 group-hover/cta:translate-x-0.5"
                >
                  <Icon name="arrow-right" class="w-3.5 h-3.5" />
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-photo-frame {
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-section.about-pending [data-about-photo-frame],
    .about-section.about-pending [data-about-eyebrow-text],
    .about-section.about-pending [data-about-heading-line],
    .about-section.about-pending [data-about-copy],
    .about-section.about-pending [data-about-closing],
    .about-section.about-pending [data-about-cta] {
      opacity: 0;
    }

    .about-section.about-pending [data-about-eyebrow-line] {
      transform: scaleX(0);
    }

    .about-section.about-pending [data-about-divider] {
      transform: scaleY(0);
      opacity: 0;
    }
  }
</style>

<script>
  import {
    mountAboutChoreography,
    type AboutChoreographyHandle,
  } from '../../scripts/about-choreography';

  let handle: AboutChoreographyHandle | null = null;

  function initAboutSection() {
    handle?.destroy();
    handle = null;

    const section = document.querySelector<HTMLElement>('[data-about-section]');
    if (!section) return;

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (reducedMotion) {
      section.classList.remove('about-pending');
      return;
    }

    const finePointer = window.matchMedia(
      '(hover: hover) and (pointer: fine)'
    ).matches;

    handle = mountAboutChoreography(section, { finePointer });
  }

  document.addEventListener('astro:page-load', initAboutSection);
  document.addEventListener('astro:before-swap', () => {
    handle?.destroy();
    handle = null;
  });
</script>
