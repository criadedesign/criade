---
import { Image } from 'astro:assets';
import { aboutContent } from '../../data/site-content';
import aboutStudioMugImg from '../../assets/about/about-studio-mug.webp';
---

<section
  id="sobre"
  aria-labelledby="sobre-heading"
  data-about-section
  class="about-section about-pending py-16 md:py-24 bg-[#F9F8F6] scroll-mt-20"
>
  <div class="container-editorial">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Coluna 1 (Esquerda): Apenas a foto limpa -->
      <div class="lg:col-span-4">
        <div
          data-about-photo-frame
          class="overflow-hidden rounded-2xl bg-[#111111]"
        >
          <Image
            src={aboutStudioMugImg}
            alt={aboutContent.imageAlt}
            width={1024}
            height={576}
            loading="lazy"
            decoding="async"
            data-about-photo-img
            class="w-full h-auto object-cover block"
          />
        </div>
      </div>

      <!-- Coluna 2 (Meio): Pequeno texto em H1 -->
      <div class="lg:col-span-4 lg:pl-4">
        <div class="inline-flex items-center gap-3 mb-4">
          <span
            data-about-eyebrow-line
            class="w-7 h-[2px] bg-[#F47721] origin-left block"
            aria-hidden="true"
          ></span>
          <span
            data-about-eyebrow-text
            class="text-[11px] font-bold tracking-[0.14em] uppercase text-[#F47721]"
          >
            {aboutContent.eyebrow}
          </span>
        </div>

        <h1
          id="sobre-heading"
          class="font-extrabold text-xl sm:text-2xl xl:text-[1.65rem] leading-[1.18] tracking-[-0.025em] text-[#171717]"
        >
          {aboutContent.h1Lines.map((line) => (
            <span data-about-heading-line class="block">
              {line}
            </span>
          ))}
          <span data-about-heading-line class="block text-[#F47721]">
            {aboutContent.h1Accent}
          </span>
        </h1>
      </div>

      <!-- Coluna 3 (Direita): Texto em H3 -->
      <div class="lg:col-span-4 relative lg:pl-8">
        <span
          data-about-divider
          class="hidden lg:block absolute left-0 top-0 bottom-0 w-px bg-[#DCD8D0] origin-top"
          aria-hidden="true"
        ></span>

        <h3
          data-about-copy
          class="text-xs sm:text-[13.5px] font-normal text-[#3B3B3B] leading-relaxed"
        >
          {aboutContent.h3Text}
        </h3>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .about-section.about-pending [data-about-photo-frame],
    .about-section.about-pending [data-about-eyebrow-text],
    .about-section.about-pending [data-about-heading-line],
    .about-section.about-pending [data-about-copy] {
      opacity: 0;
    }

    .about-section.about-pending [data-about-eyebrow-line] {
      transform: scaleX(0);
    }

    .about-section.about-pending [data-about-divider] {
      transform: scaleY(0);
      opacity: 0;
    }
  }
</style>

<script>
  import {
    mountAboutChoreography,
    type AboutChoreographyHandle,
  } from '../../scripts/about-choreography';

  let handle: AboutChoreographyHandle | null = null;

  function initAboutSection() {
    handle?.destroy();
    handle = null;

    const section = document.querySelector<HTMLElement>('[data-about-section]');
    if (!section) return;

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (reducedMotion) {
      section.classList.remove('about-pending');
      return;
    }

    handle = mountAboutChoreography(section);
  }

  document.addEventListener('astro:page-load', initAboutSection);
  document.addEventListener('astro:before-swap', () => {
    handle?.destroy();
    handle = null;
  });
</script>
