---
interface Props {
  modelUrl?: string;
  splineSceneUrl?: string;
}

const {
  modelUrl = '/models/criade-sculpture.glb',
  splineSceneUrl = '',
} = Astro.props;
---

<div
  data-hero-3d-stage
  class="relative w-full h-full"
  aria-hidden="true"
>
  <!-- Placeholder SSR Instantâneo (Zero impacto em LCP e fallback automático caso WebGL falhe) -->
  <svg
    data-hero-3d-fallback
    viewBox="0 0 648 648"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="absolute inset-0 w-full h-full overflow-visible transition-opacity duration-500 ease-out"
  >
    <path
      d="M 520.1 248.7 A 210 210 0 1 1 419.3 136.9"
      stroke="#F47721"
      stroke-width="84"
      stroke-linecap="butt"
    />
    <circle cx="480.1" cy="183.5" r="42" fill="#F47721" />
  </svg>

  <!-- Canvas WebGL Transparente (Spline Runtime @splinetool/runtime ou Engine GLB + Shaders GLSL) -->
  <canvas
    data-hero-3d-canvas
    data-model-url={modelUrl}
    data-spline-url={splineSceneUrl}
    class="relative z-10 block w-full h-full opacity-0 transition-opacity duration-700 ease-out"
  ></canvas>
</div>

<script>
  import {
    initHeroWebGLExperience,
    teardownHeroWebGLExperience,
  } from '../../scripts/hero-webgl-experience';

  let bootedOnce = false;
  function boot3D() {
    initHeroWebGLExperience();
    bootedOnce = true;
  }

  document.addEventListener('astro:page-load', boot3D);
  document.addEventListener('astro:before-preparation', teardownHeroWebGLExperience);

  if (!bootedOnce && document.readyState !== 'loading') {
    boot3D();
  }
</script>

