---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import { aboutPageContent } from '../data/site-content';
import aboutStudioMugImg from '../assets/about/about-studio-mug.webp';
---

<BaseLayout
  title={aboutPageContent.meta.title}
  description={aboutPageContent.meta.description}
  canonicalPath="/sobre"
  pageType="AboutPage"
>
  <Header />

  <main
    id="conteudo-principal"
    data-sobre-page
    class="relative overflow-hidden bg-[#F9F8F6] text-[#171717]"
  >
    <!-- ATO 00: HERO MANIFESTO EDITORIAL & INSTALAÇÃO VISUAL -->
    <section
      data-sobre-hero
      class="sobre-section sobre-pending relative pt-10 pb-20 md:pt-14 md:pb-28 lg:pb-32 overflow-hidden border-b border-[#E6E2DA]"
    >
      <svg
        class="pointer-events-none absolute inset-0 w-full h-full z-0"
        viewBox="0 0 1440 880"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path
          data-sobre-hero-drawable
          d="M-80 690 C 260 510, 620 760, 980 420 C 1180 230, 1340 120, 1540 160"
          stroke="#F47721"
          stroke-opacity="0.26"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <path
          data-sobre-hero-drawable
          d="M 880 -40 C 780 280, 1080 520, 1520 620"
          stroke="#171717"
          stroke-opacity="0.08"
          stroke-width="1.15"
          stroke-dasharray="6 8"
          stroke-linecap="round"
        />
        <circle
          data-sobre-hero-drawable
          cx="1110"
          cy="340"
          r="240"
          stroke="#F47721"
          stroke-opacity="0.16"
          stroke-width="1.1"
        />
      </svg>

      <div class="container-editorial relative z-10">
        <div
          data-sobre-hero-index
          class="flex flex-wrap items-center justify-between gap-4 pb-7 mb-10 md:mb-14 border-b border-[#E5E0D7]"
        >
          <div class="flex items-center gap-3">
            <a
              href="/#sobre"
              class="inline-flex items-center gap-2 rounded-full border border-[#171717]/15 bg-white/80 hover:border-[#F47721] hover:text-[#F47721] px-3.5 py-1.5 text-[11px] font-semibold tracking-[0.08em] uppercase transition-colors"
            >
              <span aria-hidden="true">←</span>
              <span>Início</span>
            </a>
            <span class="text-[11px] font-bold tracking-[0.16em] uppercase text-[#6E6A63]">
              {aboutPageContent.hero.indexTag}
            </span>
          </div>

          <div class="hidden sm:flex items-center gap-4 text-[11px] font-medium tracking-[0.14em] uppercase text-[#6E6A63]">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#F47721] animate-pulse"></span>
              <span>EDIÇÃO CONCEITUAL</span>
            </span>
            <span class="text-[#DCD8D0]">|</span>
            <span>DESIGN • ESTRATÉGIA • TECNOLOGIA</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-start">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-3 mb-5">
              <span class="w-9 h-[2px] bg-[#F47721]" aria-hidden="true"></span>
              <span class="text-xs font-bold tracking-[0.18em] uppercase text-[#F47721]">
                {aboutPageContent.hero.eyebrow}
              </span>
            </div>

            <h1
              class="font-extrabold text-[2.2rem] sm:text-[3.1rem] lg:text-[3.55rem] xl:text-[4rem] leading-[1.03] tracking-[-0.035em] text-[#141414]"
              style="perspective: 900px;"
            >
              {aboutPageContent.hero.headlineLines.map((line) => (
                <span data-sobre-hero-line class="block">
                  {line}
                </span>
              ))}
              <span
                data-sobre-hero-accent
                class="block text-[#F47721] mt-1"
              >
                {aboutPageContent.hero.headlineAccent}
              </span>
            </h1>

            <div class="mt-10 md:mt-12 pt-8 border-t border-[#E5E0D7] grid grid-cols-1 sm:grid-cols-12 gap-6 sm:gap-8">
              <div data-sobre-manifesto-item class="sm:col-span-6">
                <span class="block text-[10px] font-bold tracking-[0.18em] uppercase text-[#F47721] mb-2.5">
                  // ESSÊNCIA & IDENTIDADE
                </span>
                <p class="text-[15px] sm:text-[16px] font-semibold text-[#171717] leading-[1.58]">
                  {aboutPageContent.hero.manifestoLead}
                </p>
              </div>

              <div data-sobre-manifesto-item class="sm:col-span-6">
                <span class="block text-[10px] font-bold tracking-[0.18em] uppercase text-[#6E6A63] mb-2.5">
                  // CONVERGÊNCIA DE PERSPECTIVAS
                </span>
                <p class="text-[14px] sm:text-[15px] text-[#45423D] leading-[1.68]">
                  {aboutPageContent.hero.manifestoBody}
                </p>
              </div>
            </div>

            <div
              data-sobre-manifesto-item
              class="mt-8 rounded-2xl bg-[#141414] text-white p-6 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5 shadow-[0_22px_50px_-22px_rgba(20,20,20,0.45)]"
            >
              <div class="flex items-start sm:items-center gap-4">
                <span
                  class="mt-1 sm:mt-0 inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#F47721]/18 border border-[#F47721]/40 text-[#F47721] shrink-0 font-bold text-sm"
                >
                  ✦
                </span>
                <p class="text-[15px] sm:text-[17px] font-bold tracking-[-0.01em] leading-snug">
                  {aboutPageContent.hero.manifestoSignature}
                </p>
              </div>

              <a
                href="#triade-viva"
                data-sobre-magnetic
                class="inline-flex items-center gap-2.5 self-start sm:self-auto shrink-0 rounded-full bg-[#F47721] hover:bg-[#ff8533] text-white px-5 py-2.5 text-xs font-semibold tracking-[0.04em] uppercase transition-colors"
              >
                <span>Explorar Manifesto</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 relative">
            <div
              data-sobre-art-stage
              class="sobre-art-stage relative rounded-[26px] bg-[#121212] p-3 sm:p-4 shadow-[0_32px_70px_-24px_rgba(17,17,17,0.42)] border border-[#171717]/15"
            >
              <div class="flex items-center justify-between px-2 pb-3 text-[10px] font-semibold tracking-[0.16em] uppercase text-white/65">
                <span class="inline-flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-[#F47721]"></span>
                  <span>FIG. 01 — ESTÚDIO CRIADE</span>
                </span>
                <span class="text-white/45">SIMBOLOGIA & OBJETO</span>
              </div>

              <div class="relative overflow-hidden rounded-[18px] aspect-[16/10] bg-[#0A0A0A]">
                <Image
                  src={aboutStudioMugImg}
                  alt="Mesa do estúdio Criade com caneca preta e símbolo circular laranja"
                  width={1024}
                  height={576}
                  loading="eager"
                  decoding="async"
                  data-sobre-art-img
                  class="w-full h-full object-cover object-center block will-change-transform"
                />

                <svg
                  class="pointer-events-none absolute inset-0 w-full h-full"
                  viewBox="0 0 640 400"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    data-sobre-hero-drawable
                    d="M 24 344 C 170 250, 340 272, 480 368"
                    stroke="#F47721"
                    stroke-width="1.6"
                    stroke-opacity="0.7"
                    stroke-linecap="round"
                  />
                  <circle
                    data-sobre-hero-drawable
                    cx="402"
                    cy="210"
                    r="94"
                    stroke="#F47721"
                    stroke-width="1.2"
                    stroke-opacity="0.42"
                    stroke-dasharray="4 6"
                  />
                </svg>

                <div
                  class="pointer-events-none absolute bottom-3 left-3 flex items-center gap-2.5 rounded-xl bg-black/65 backdrop-blur-md border border-white/12 px-3.5 py-2 text-white"
                >
                  <svg
                    data-sobre-compass
                    class="w-7 h-7 text-[#F47721] shrink-0"
                    viewBox="0 0 36 36"
                    fill="none"
                    aria-hidden="true"
                  >
                    <circle
                      cx="18"
                      cy="18"
                      r="15"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-dasharray="3 3"
                    />
                    <circle cx="18" cy="18" r="4.5" fill="currentColor" />
                    <path
                      d="M18 2V8M18 28V34M2 18H8M28 18H34"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                    />
                  </svg>
                  <div>
                    <span class="block text-[9px] tracking-[0.18em] uppercase text-white/60">
                      PONTO DE CONVERGÊNCIA
                    </span>
                    <span class="block text-[11px] font-bold tracking-[0.04em] text-white">
                      Criatividade × Estratégia × Tecnologia
                    </span>
                  </div>
                </div>
              </div>

              <div class="mt-3.5 grid grid-cols-3 gap-2 pt-2 border-t border-white/10 text-center">
                <div class="rounded-lg bg-white/[0.04] py-2 px-2">
                  <span class="block text-[9px] tracking-[0.16em] uppercase text-white/50">
                    FORÇA 01
                  </span>
                  <span class="block text-xs font-bold text-white mt-0.5">
                    Criatividade
                  </span>
                </div>
                <div class="rounded-lg bg-white/[0.04] py-2 px-2">
                  <span class="block text-[9px] tracking-[0.16em] uppercase text-white/50">
                    FORÇA 02
                  </span>
                  <span class="block text-xs font-bold text-[#F47721] mt-0.5">
                    Estratégia
                  </span>
                </div>
                <div class="rounded-lg bg-white/[0.04] py-2 px-2">
                  <span class="block text-[9px] tracking-[0.16em] uppercase text-white/50">
                    FORÇA 03
                  </span>
                  <span class="block text-xs font-bold text-white mt-0.5">
                    Tecnologia
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ATO 01: A TRÍADE VIVA (CARBON DARK UI) -->
    <section
      id="triade-viva"
      data-sobre-triad
      class="sobre-section sobre-pending relative py-24 md:py-32 bg-[#0B0B0D] text-white overflow-hidden scroll-mt-20"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-30"
        style="background-image: linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 64px 64px;"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute -top-40 right-1/4 w-[520px] h-[520px] rounded-full bg-[#F47721]/12 blur-[130px]"
        aria-hidden="true"
      ></div>

      <div class="container-editorial relative z-10">
        <div class="max-w-3xl mb-14 md:mb-18">
          <div class="inline-flex items-center gap-3 mb-4">
            <span class="w-8 h-[2px] bg-[#F47721]" aria-hidden="true"></span>
            <span class="text-xs font-bold tracking-[0.18em] uppercase text-[#F47721]">
              {aboutPageContent.triad.eyebrow}
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-[-0.03em] leading-[1.08] text-white">
            {aboutPageContent.triad.title}
          </h2>
          <p class="mt-4 text-sm sm:text-base text-white/70 leading-relaxed max-w-2xl">
            {aboutPageContent.triad.subtitle}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-7">
          {aboutPageContent.triad.pillars.map((pillar, idx) => (
            <article
              data-triad-card
              class="triad-dark-card group relative rounded-[24px] bg-[#131316] border border-white/10 hover:border-[#F47721]/55 p-7 sm:p-8 flex flex-col justify-between overflow-hidden transition-colors duration-300"
            >
              <div>
                <div class="flex items-center justify-between gap-4 mb-7">
                  <div>
                    <span class="block text-[10px] font-bold tracking-[0.18em] uppercase text-[#F47721]">
                      {pillar.code}
                    </span>
                    <span class="text-2xl font-extrabold text-white/25 group-hover:text-[#F47721]/80 transition-colors">
                      {pillar.index}
                    </span>
                  </div>

                  <div class="w-14 h-14 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center">
                    {idx === 0 && (
                      <svg class="w-8 h-8 text-[#F47721]" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                        <circle
                          data-triad-drawable
                          cx="20"
                          cy="20"
                          r="14"
                          stroke="currentColor"
                          stroke-width="1.7"
                        />
                        <circle
                          data-triad-drawable
                          cx="14"
                          cy="14"
                          r="3.5"
                          stroke="currentColor"
                          stroke-width="1.7"
                        />
                      </svg>
                    )}
                    {idx === 1 && (
                      <svg class="w-8 h-8 text-[#F47721]" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                        <path
                          data-triad-drawable
                          d="M7 33L33 7M33 7H15M33 7V25"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                    {idx === 2 && (
                      <svg class="w-8 h-8 text-[#F47721]" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                        <path
                          data-triad-drawable
                          d="M8 20H32M20 8V32M11 11L29 29M29 11L11 29"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                        />
                      </svg>
                    )}
                  </div>
                </div>

                <p class="text-xs font-bold uppercase tracking-[0.12em] text-[#F47721] mb-2">
                  “{pillar.axiom}”
                </p>

                <h3 class="text-xl sm:text-2xl font-bold text-white tracking-[-0.02em] mb-3.5">
                  {pillar.title}
                </h3>

                <p class="text-sm text-white/70 leading-[1.68]">
                  {pillar.description}
                </p>
              </div>

              <div class="mt-8 pt-5 border-t border-white/10 flex flex-wrap gap-2">
                {pillar.keywords.map((kw) => (
                  <span class="rounded-full bg-white/[0.05] border border-white/10 px-3 py-1 text-[11px] font-medium text-white/80">
                    {kw}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ATO 02: ALQUIMIA DE VALOR -->
    <section
      data-sobre-alchemy
      class="sobre-section sobre-pending relative py-24 md:py-32 bg-[#F4F1EA] border-b border-[#E5E0D5]"
    >
      <div class="container-editorial">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-14 md:mb-18">
          <div class="lg:col-span-7">
            <div class="inline-flex items-center gap-3 mb-4">
              <span class="w-8 h-[2px] bg-[#F47721]" aria-hidden="true"></span>
              <span class="text-xs font-bold tracking-[0.18em] uppercase text-[#F47721]">
                {aboutPageContent.alchemy.eyebrow}
              </span>
            </div>
            <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-[-0.03em] leading-[1.08] text-[#171717]">
              {aboutPageContent.alchemy.title}
            </h2>
          </div>
          <div class="lg:col-span-5">
            <p class="text-sm sm:text-base text-[#4A4742] leading-relaxed">
              {aboutPageContent.alchemy.subtitle}
            </p>
          </div>
        </div>

        <div class="space-y-5">
          {aboutPageContent.alchemy.transformations.map((item) => (
            <div
              data-alchemy-row
              class="group relative rounded-[22px] bg-[#F9F8F6] hover:bg-white border border-[#E2DDD3] hover:border-[#F47721]/60 p-6 sm:p-8 lg:px-10 transition-all duration-300 shadow-[0_10px_30px_-18px_rgba(23,23,23,0.12)]"
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <div class="lg:col-span-7 flex flex-wrap sm:flex-nowrap items-center gap-4 sm:gap-6">
                  <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#171717] text-white text-xs font-bold shrink-0">
                    {item.index}
                  </span>

                  <span class="text-xl sm:text-2xl lg:text-[1.75rem] font-bold text-[#6E6A63] group-hover:text-[#171717] transition-colors">
                    {item.from}
                  </span>

                  <div class="flex-1 min-w-[70px] max-w-[140px] flex items-center">
                    <svg
                      class="w-full h-6 text-[#F47721]"
                      viewBox="0 0 120 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        data-alchemy-drawable
                        d="M4 12H112M112 12L102 5M112 12L102 19"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>

                  <span class="text-xl sm:text-2xl lg:text-[1.85rem] font-extrabold text-[#F47721] tracking-[-0.02em]">
                    {item.to}
                  </span>
                </div>

                <div class="lg:col-span-5 lg:border-l lg:border-[#E5E0D7] lg:pl-8">
                  <p class="text-xs sm:text-sm text-[#45423D] leading-relaxed">
                    {item.caption}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ATO 03: ARQUITETURA DE PROCESSO -->
    <section
      data-sobre-method
      class="sobre-section sobre-pending relative py-24 md:py-32 bg-[#F9F8F6]"
    >
      <div class="container-editorial">
        <div class="max-w-3xl mb-14 md:mb-18">
          <div class="inline-flex items-center gap-3 mb-4">
            <span class="w-8 h-[2px] bg-[#F47721]" aria-hidden="true"></span>
            <span class="text-xs font-bold tracking-[0.18em] uppercase text-[#F47721]">
              {aboutPageContent.method.eyebrow}
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-[-0.03em] leading-[1.08] text-[#171717]">
            {aboutPageContent.method.title}
          </h2>
          <p class="mt-4 text-sm sm:text-base text-[#4A4742] leading-relaxed">
            {aboutPageContent.method.subtitle}
          </p>
        </div>

        <div class="hidden lg:block mb-6">
          <svg
            class="w-full h-5"
            viewBox="0 0 1200 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              data-method-drawable
              d="M 10 10 H 1190"
              stroke="#F47721"
              stroke-width="1.5"
              stroke-dasharray="6 6"
            />
          </svg>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {aboutPageContent.method.steps.map((item) => (
            <div
              data-method-step
              class="rounded-[20px] bg-white border border-[#E5E0D7] hover:border-[#F47721] p-6 sm:p-7 flex flex-col justify-between transition-colors duration-300 shadow-[0_14px_34px_-22px_rgba(17,17,17,0.14)]"
            >
              <div>
                <div class="inline-flex items-center gap-2 rounded-full bg-[#F47721]/10 text-[#F47721] px-3 py-1 text-[10px] font-bold tracking-[0.16em] uppercase mb-5">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#F47721]"></span>
                  <span>{item.step}</span>
                </div>

                <h3 class="text-lg sm:text-xl font-bold text-[#171717] mb-3">
                  {item.title}
                </h3>

                <p class="text-xs sm:text-[13.5px] text-[#4A4742] leading-[1.68]">
                  {item.description}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-[#F0ECE4] flex items-center justify-between text-[11px] font-semibold text-[#8C877E]">
                <span>MÉTODO CRIADE</span>
                <span class="text-[#F47721]">→</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ATO 04: EPÍLOGO MONUMENTAL -->
    <section
      data-sobre-epilogue
      class="sobre-section sobre-pending relative pb-24 md:pb-32 bg-[#F9F8F6]"
    >
      <div class="container-editorial">
        <div class="relative overflow-hidden rounded-[28px] bg-[#141416] text-white p-8 sm:p-12 lg:p-16 shadow-[0_32px_80px_-28px_rgba(17,17,17,0.55)]">
          <svg
            class="pointer-events-none absolute inset-0 w-full h-full"
            viewBox="0 0 1200 420"
            fill="none"
            preserveAspectRatio="xMidYMid slice"
            aria-hidden="true"
          >
            <path
              data-epilogue-drawable
              d="M -40 360 C 310 180, 680 420, 1240 90"
              stroke="#F47721"
              stroke-width="1.8"
              stroke-opacity="0.35"
              stroke-linecap="round"
            />
            <circle
              data-epilogue-drawable
              cx="1040"
              cy="190"
              r="180"
              stroke="#F47721"
              stroke-width="1.2"
              stroke-opacity="0.22"
            />
          </svg>

          <div class="relative z-10 max-w-3xl">
            <div
              data-epilogue-item
              class="inline-flex items-center gap-3 mb-5"
            >
              <span class="w-8 h-[2px] bg-[#F47721]" aria-hidden="true"></span>
              <span class="text-xs font-bold tracking-[0.18em] uppercase text-[#F47721]">
                {aboutPageContent.epilogue.eyebrow}
              </span>
            </div>

            <h2
              data-epilogue-item
              class="text-2xl sm:text-4xl lg:text-[2.9rem] font-extrabold tracking-[-0.03em] leading-[1.1]"
            >
              <span class="block text-white/90">
                {aboutPageContent.epilogue.quoteLine1}
              </span>
              <span class="block text-[#F47721] mt-1">
                {aboutPageContent.epilogue.quoteLine2}
              </span>
            </h2>

            <div
              data-epilogue-item
              class="mt-9 flex flex-wrap items-center gap-4"
            >
              <a
                href={aboutPageContent.epilogue.ctaPrimary.href}
                data-sobre-magnetic
                class="inline-flex items-center gap-3 rounded-full bg-[#F47721] hover:bg-[#ff8533] text-white px-7 py-3.5 text-xs sm:text-sm font-semibold transition-colors shadow-[0_14px_30px_-8px_rgba(244,119,33,0.5)]"
              >
                <span>{aboutPageContent.epilogue.ctaPrimary.label}</span>
                <Icon name="arrow-right" class="w-4 h-4" />
              </a>

              <a
                href={aboutPageContent.epilogue.ctaSecondary.href}
                data-sobre-magnetic
                class="inline-flex items-center gap-3 rounded-full border border-white/20 hover:border-white/50 bg-white/[0.04] hover:bg-white/[0.1] text-white px-6 py-3.5 text-xs sm:text-sm font-semibold transition-colors"
              >
                <span>{aboutPageContent.epilogue.ctaSecondary.label}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .sobre-art-stage {
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .triad-dark-card::before {
    content: '';
    pointer-events: none;
    position: absolute;
    inset: 0;
    background: radial-gradient(
      420px circle at var(--spot-x, 50%) var(--spot-y, 0%),
      rgba(244, 119, 33, 0.14),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .triad-dark-card:hover::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-sobre-hero].sobre-pending [data-sobre-hero-index],
    [data-sobre-hero].sobre-pending [data-sobre-hero-line],
    [data-sobre-hero].sobre-pending [data-sobre-hero-accent],
    [data-sobre-hero].sobre-pending [data-sobre-art-stage],
    [data-sobre-hero].sobre-pending [data-sobre-manifesto-item],
    [data-sobre-triad].sobre-pending [data-triad-card],
    [data-sobre-alchemy].sobre-pending [data-alchemy-row],
    [data-sobre-method].sobre-pending [data-method-step],
    [data-sobre-epilogue].sobre-pending [data-epilogue-item] {
      opacity: 0;
    }
  }
</style>

<script>
  import {
    mountSobrePageChoreography,
    type SobrePageChoreographyHandle,
  } from '../scripts/sobre-page-choreography';

  let handle: SobrePageChoreographyHandle | null = null;

  function initSobrePage() {
    handle?.destroy();
    handle = null;

    const root = document.querySelector<HTMLElement>('[data-sobre-page]');
    if (!root) return;

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (reducedMotion) {
      root
        .querySelectorAll<HTMLElement>('.sobre-pending')
        .forEach((el) => el.classList.remove('sobre-pending'));
      return;
    }

    const finePointer = window.matchMedia(
      '(hover: hover) and (pointer: fine)'
    ).matches;

    handle = mountSobrePageChoreography(root, { finePointer });
  }

  document.addEventListener('astro:page-load', initSobrePage);
  document.addEventListener('astro:before-swap', () => {
    handle?.destroy();
    handle = null;
  });
</script>
