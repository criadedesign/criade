# ============================================================================
# CRIADE COMUNICAÇÃO E DESIGN — .htaccess (HOSTINGER LITESPEED / APACHE)
# Hardened Security & Zero-Trust Least-Privilege Policy
# ============================================================================

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Bloqueia acesso externo direto a diretórios e arquivos internos de código-fonte (Least Privilege)
  RewriteRule ^(src|scripts|node_modules|\.git|\.astro)/ - [F,L]
  RewriteRule ^(\.env.*|package(-lock)?\.json|astro\.config\.mjs|tsconfig\.json|\.nvmrc|README\.md)$ - [F,L]

  # Resolve rotas em diretórios estáticos (/sobre -> /sobre/index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Suporte a URLs limpas sem extensão .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg .svgz
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  AddType font/woff2 .woff2
  AddType application/javascript .js .mjs
  AddType application/wasm .wasm
  AddType application/xml .xml
  AddType text/plain .txt
  AddCharset UTF-8 .html .css .js .mjs .json .xml .txt
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE font/woff2 model/gltf+json model/gltf-binary
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2|webp|avif|glb)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security Auditor — Cabeçalhos de Segurança HTTP & Isolamento
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
